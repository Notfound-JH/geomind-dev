{
  "benchmark_name": "geomind_spatial_benchmark",
  "suite_name": "smoke",
  "description": "Minimal cross-family smoke suite built on canonical GeoMind task ids.",
  "runner_dispatch_mode": "strict",
  "diagnostic_tags": [
    "smoke_regression",
    "protocol_pass_through",
    "state_refresh_geometric_structure_joint_shell"
  ],
  "task_families": [
    "state_reindexing",
    "historical_identity_tracking",
    "explicit_rule_extrapolation",
    "implicit_trend_fitting"
  ],
  "task_ids": [
    "reindex_extreme",
    "track_single",
    "perfect_midpoint",
    "trend_continuation"
  ],
  "agent_names": [
    "oracle"
  ],
  "default_agent_groups": {
    "state_refresh": [
      "oracle"
    ],
    "geometric_structure": [
      "oracle"
    ]
  },
  "default_thresholds": {
    "min_valid_rate": 0.5,
    "min_success_rate": 0.5,
    "max_accidental_displacement_rate": 0.5,
    "max_mean_l2_error": 0.08
  },
  "output_layout": {
    "state_refresh_root": "logs/state_reindexing_matrix/<timestamp>",
    "geometric_structure_root": "logs/geometric_inference_matrix/<timestamp>",
    "manifest_file": "run_manifest.tsv",
    "aggregate_text": "aggregate.txt",
    "aggregate_csv": "aggregate.csv"
  },
  "summary_preset": {
    "joint_group_by": [
      "semantic_module",
      "task_id",
      "task_version",
      "phase",
      "agent_name",
      "task_type"
    ],
    "joint_common_fields": [
      "semantic_module",
      "task_id",
      "task_version",
      "phase",
      "agent_name",
      "episode_count",
      "valid_rate",
      "success_rate",
      "task_type"
    ],
    "state_refresh_group_by": [
      "semantic_module",
      "task_id",
      "task_version",
      "phase",
      "agent_name",
      "object_count",
      "distractor_count",
      "visual_mode"
    ],
    "geometric_structure_group_by": [
      "semantic_module",
      "task_id",
      "task_version",
      "phase",
      "agent_name",
      "noise_level",
      "anchor_count"
    ]
  }
}
