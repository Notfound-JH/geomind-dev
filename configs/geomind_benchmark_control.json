{
  "benchmark_name": "geomind_spatial_benchmark",
  "suite_name": "control",
  "description": "Control and ablation suite organized around canonical GeoMind task ids and paired-control evaluation.",
  "runner_dispatch_mode": "permissive",
  "diagnostic_tags": [
    "control_suite",
    "final_frame_shortcut",
    "distractor_filtering",
    "weak_destruction_control"
  ],
  "task_families": [
    "state_reindexing",
    "historical_identity_tracking",
    "explicit_rule_extrapolation",
    "implicit_trend_fitting"
  ],
  "task_ids": [
    "track_single",
    "reindex_subset",
    "perfect_midpoint",
    "weak_destruction_control"
  ],
  "agent_names": [
    "historical_oracle",
    "historical_final_frame_only",
    "state_refresh_core_random",
    "explicit_random",
    "implicit_trend_random"
  ],
  "default_agent_groups": {
    "state_refresh": [
      "historical_oracle",
      "historical_final_frame_only",
      "state_refresh_core_random"
    ],
    "geometric_structure": [
      "explicit_random",
      "implicit_trend_random"
    ]
  },
  "default_thresholds": {
    "min_valid_rate": 0.6,
    "min_success_rate": 0.4,
    "max_accidental_displacement_rate": 0.3,
    "max_mean_l2_error": 0.08
  },
  "output_layout": {
    "state_refresh_root": "logs/state_reindexing_matrix/<timestamp>",
    "geometric_structure_root": "logs/geometric_inference_matrix/<timestamp>",
    "manifest_file": "run_manifest.tsv",
    "aggregate_text": "aggregate.txt",
    "aggregate_csv": "aggregate.csv"
  },
  "summary_preset": {
    "joint_group_by": [
      "semantic_module",
      "task_id",
      "task_version",
      "phase",
      "agent_name",
      "task_type"
    ],
    "joint_common_fields": [
      "semantic_module",
      "task_id",
      "task_version",
      "phase",
      "agent_name",
      "episode_count",
      "valid_rate",
      "success_rate",
      "task_type"
    ],
    "state_refresh_group_by": [
      "semantic_module",
      "task_id",
      "task_version",
      "phase",
      "agent_name",
      "object_count",
      "distractor_count",
      "visual_mode"
    ],
    "geometric_structure_group_by": [
      "semantic_module",
      "task_id",
      "task_version",
      "phase",
      "agent_name",
      "noise_level",
      "anchor_count"
    ]
  }
}
