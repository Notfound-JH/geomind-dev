+#!/usr/bin/env python3
+
+# Copyright (c) 2022-2026, The Isaac Lab Project Developers.
+# All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+
+"""Load an Isaac Lab/GeoMind env by task ID and print all observation fields."""
+
+import argparse
+import sys
+from pathlib import Path
+
+from isaaclab.app import AppLauncher
+
+
+parser = argparse.ArgumentParser(description="Print all observation fields for a task.")
+parser.add_argument("--task", type=str, default="", help="Gym task ID.")
+parser.add_argument("--num_envs", type=int, default=1, help="Number of envs to create.")
+parser.add_argument("--device", type=str, default="cuda:0", help="Simulation device.")
+parser.add_argument("--disable_fabric", action="store_true", default=False, help="Disable fabric and use USD I/O.")
+parser.add_argument(
+    "--geomind_repo",
+    type=str,
+    default="",
+    help="Path to GeoMind repo root (e.g. /home/elm/projects/geomind/geomind_env_1).",
+)
+parser.add_argument(
+    "--use_first_geomind_task",
+    action="store_true",
+    default=False,
+    help="If --task is empty, use the first registered GeoMind task.",
+)
+AppLauncher.add_app_launcher_args(parser)
+args_cli = parser.parse_args()
+args_cli.headless = True
+
+app_launcher = AppLauncher(args_cli)
+simulation_app = app_launcher.app
+
+
+def _print_observation_structure(obs) -> None:
+    print("\n[INFO] Observation payload from env.reset():")
+    if not isinstance(obs, dict):
+        shape = tuple(obs.shape) if hasattr(obs, "shape") else type(obs)
+        print(f"- reset() returned non-dict observation: {shape}")
+        return
+
+    for group_name, group_obs in obs.items():
+        print(f"- group: {group_name}")
+        if isinstance(group_obs, dict):
+            for term_name, term_value in group_obs.items():
+                term_shape = tuple(term_value.shape) if hasattr(term_value, "shape") else type(term_value)
+                print(f"  - term: {term_name:>24s} | shape={term_shape}")
+        else:
+            group_shape = tuple(group_obs.shape) if hasattr(group_obs, "shape") else type(group_obs)
+            print(f"  - concatenated tensor shape={group_shape}")
+
+
+def _try_register_geomind_tasks() -> tuple[str, ...]:
+    if args_cli.geomind_repo:
+        repo_path = Path(args_cli.geomind_repo).expanduser().resolve()
+        if not repo_path.is_dir():
+            raise FileNotFoundError(f"GeoMind repo path not found: {repo_path}")
+        if str(repo_path) not in sys.path:
+            sys.path.insert(0, str(repo_path))
+
+    try:
+        import geomind_tasks  # noqa: F401
+        from geomind_tasks.manipulation.geomind_env.config import franka as franka_registry
+
+        return tuple(franka_registry.SUPPORTED_GEOMIND_TASKS)
+    except Exception:
+        return ()
+
+
+def main() -> None:
+    import gymnasium as gym
+
+    import isaaclab_tasks  # noqa: F401
+    from isaaclab_tasks.utils import parse_env_cfg
+
+    geomind_tasks = _try_register_geomind_tasks()
+    task_name = args_cli.task
+    if not task_name and args_cli.use_first_geomind_task:
+        if not geomind_tasks:
+            raise RuntimeError(
+                "No GeoMind tasks found. Provide --task directly or pass --geomind_repo and ensure geomind_tasks is importable."
+            )
+        task_name = geomind_tasks[0]
+        print(f"[INFO] --task not provided. Using first GeoMind task: {task_name}")
+    if not task_name:
+        raise ValueError("Please provide --task, or set --use_first_geomind_task.")
+
+    env_cfg = parse_env_cfg(
+        task_name,
+        device=args_cli.device,
+        num_envs=args_cli.num_envs,
+        use_fabric=not args_cli.disable_fabric,
+    )
+    env = gym.make(task_name, cfg=env_cfg).unwrapped
+
+    try:
+        print(f"[INFO] Loaded task: {task_name}")
+        if geomind_tasks:
+            print(f"[INFO] Registered GeoMind tasks: {len(geomind_tasks)}")
+        print(f"[INFO] num_envs={env.num_envs}, device={env.device}")
+
+        print("\n[INFO] Observation fields from observation manager:")
+        for group_name, term_names in env.observation_manager.active_terms.items():
+            print(f"- group: {group_name}")
+            print(f"  - terms: {', '.join(term_names) if term_names else '(none)'}")
+
+        print("\n[INFO] Observation dims:")
+        for group_name, group_dim in env.observation_manager.group_obs_dim.items():
+            print(f"- group: {group_name} | dim={group_dim}")
+
+        obs, _ = env.reset()
+        _print_observation_structure(obs)
+    finally:
+        env.close()
+
+
+if __name__ == "__main__":
+    main()
+    simulation_app.close()
