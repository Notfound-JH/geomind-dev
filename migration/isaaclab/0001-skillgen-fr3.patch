+"""Configuration for Franka Research 3 (FR3) robot in Isaac Lab style."""
+
+import math
+import isaaclab.sim as sim_utils
+from isaaclab.actuators import ImplicitActuatorCfg
+from isaaclab.assets.articulation import ArticulationCfg
+
+# ---------------------------
+# Real-spec constants (FR3)
+# From FR3 datasheet:
+# - A1-A4 torque: ±87 Nm
+# - A5-A7 torque: ±12 Nm
+# - A1-A4 vel: 150 deg/s
+# - A5-A7 vel: 301 deg/s (FCI: A6 239 deg/s)
+# ---------------------------
+FR3_TAU_ARM = 87.0
+FR3_TAU_WRIST = 12.0
+
+FR3_VEL_ARM = math.radians(150.0)          # 2.61799 rad/s
+FR3_VEL_WRIST = math.radians(301.0)        # 5.25344 rad/s
+FR3_VEL_J6_FCI = math.radians(239.0)       # 4.17134 rad/s (optional, if you care)
+
+# Franka Hand (if you are using the 2-finger Franka Hand):
+# - continuous grasping force: 30-70 N
+# - travel speed per finger: 50 mm/s
+FRANKA_HAND_FORCE = 70.0      # N  (prismatic joint effort)
+FRANKA_HAND_VEL = 0.05        # m/s (50 mm/s)
+
+FRANKA_FR3_CFG = ArticulationCfg(
+    spawn=sim_utils.UsdFileCfg(
+        usd_path="/home/elm/isaacsim_assets/Assets/Isaac/4.5/Isaac/Robots/Franka/FR3/fr3.usd",
+        activate_contact_sensors=False,
+        rigid_props=sim_utils.RigidBodyPropertiesCfg(
+            disable_gravity=False,
+            max_depenetration_velocity=5.0,
+        ),
+        articulation_props=sim_utils.ArticulationRootPropertiesCfg(
+            # Self-collision ON can be noisy for RL; if you see jitter, try False.
+            enabled_self_collisions=True,
+            # Slightly stronger than your original for stability
+            solver_position_iteration_count=12,
+            solver_velocity_iteration_count=1,
+        ),
+        # If you see penetration at contacts, you can enable:
+        # collision_props=sim_utils.CollisionPropertiesCfg(contact_offset=0.005, rest_offset=0.0),
+    ),
+
+    # A "home-ish" pose (keep it away from extreme limits)
+    init_state=ArticulationCfg.InitialStateCfg(
+        joint_pos={
+            "fr3_joint1": 0.0,
+            "fr3_joint2": -1.0,
+            "fr3_joint3": 0.0,
+            "fr3_joint4": -2.3,
+            "fr3_joint5": 0.0,
+            "fr3_joint6": 1.8,
+            "fr3_joint7": 0.8,
+            # 0.04 m per finger -> 0.08 m total opening matches Franka Hand travel range
+            "fr3_finger_joint.*": 0.04,
+        }
+    ),
+
+    actuators={
+        # ---- Arm: joints 1-4 (87 Nm, 150 deg/s) ----
+        "fr3_arm": ImplicitActuatorCfg(
+            joint_names_expr=["fr3_joint[1-4]"],
+            effort_limit_sim=FR3_TAU_ARM,
+            velocity_limit_sim=FR3_VEL_ARM,
+            # Start from "Isaac-Lab-like" conservative gains (stable, not too stiff)
+            stiffness=80.0,
+            damping=4.0,
+        ),
+
+        # ---- Wrist: joints 5-7 (12 Nm, 301 deg/s; optional special-casing for j6) ----
+        "fr3_wrist": ImplicitActuatorCfg(
+            joint_names_expr=["fr3_joint[5|7]"],
+            effort_limit_sim=FR3_TAU_WRIST,
+            velocity_limit_sim=FR3_VEL_WRIST,
+            stiffness=40.0,
+            damping=2.0,
+        ),
+        "fr3_wrist_j6": ImplicitActuatorCfg(
+            joint_names_expr=["fr3_joint6"],
+            effort_limit_sim=FR3_TAU_WRIST,
+            # If you want to match the datasheet "FCI use" note, use FR3_VEL_J6_FCI.
+            velocity_limit_sim=FR3_VEL_WRIST,
+            stiffness=40.0,
+            damping=2.0,
+        ),
+
+        # ---- Gripper (prismatic): force in N, velocity in m/s ----
+        "fr3_hand": ImplicitActuatorCfg(
+            joint_names_expr=["fr3_finger_joint[1|2]"],
+            effort_limit_sim=FRANKA_HAND_FORCE,
+            velocity_limit_sim=FRANKA_HAND_VEL,
+            # Gripper usually needs higher stiffness than arm joints to hold objects firmly.
+            stiffness=5000.0,
+            damping=200.0,
+        ),
+    },
+
+    soft_joint_pos_limit_factor=1.0,
+)
+"""Configuration of Franka Research 3 (FR3) robot."""
+FRANKA_FR3_HIGH_PD_CFG = FRANKA_FR3_CFG.copy()
