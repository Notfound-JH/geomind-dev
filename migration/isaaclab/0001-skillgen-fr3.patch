@@ -95,6 +95,12 @@ class SubTaskConfig:
     Set to None if no object is involved (this is rarely the case).
     """
 
+    object_name: str = None
+    """Alias of :attr:`object_ref` used by newer SkillGen task specs."""
+
+    subtask_start_signal: str | None = None
+    """Subtask start signal name used by SkillGen."""
+
     subtask_term_signal: str = None
     """Subtask termination signal name."""
 
@@ -149,6 +155,29 @@ class SubTaskConfig:
     next_subtask_description: str = ""
     """Instructions for the next subtask"""
 
+    def __post_init__(self):
+        """Normalize aliases and validate offset range settings."""
+        if self.object_name is None and self.object_ref is not None:
+            self.object_name = self.object_ref
+        elif self.object_ref is None and self.object_name is not None:
+            self.object_ref = self.object_name
+        elif self.object_name is not None and self.object_ref is not None and self.object_name != self.object_ref:
+            raise ValueError(
+                f"SubTaskConfig object mismatch: object_name='{self.object_name}' != object_ref='{self.object_ref}'"
+            )
+
+        self._validate_offset_range(self.first_subtask_start_offset_range, "first_subtask_start_offset_range")
+        self._validate_offset_range(self.subtask_start_offset_range, "subtask_start_offset_range")
+        self._validate_offset_range(self.subtask_term_offset_range, "subtask_term_offset_range")
+
+    @staticmethod
+    def _validate_offset_range(value: tuple, field_name: str) -> None:
+        if not isinstance(value, tuple) or len(value) != 2:
+            raise ValueError(f"{field_name} must be a tuple(int, int), got: {value}")
+        low, high = value
+        if low > high:
+            raise ValueError(f"{field_name} has invalid bounds: low={low} must be <= high={high}")
+
 
 class SubTaskConstraintType(enum.IntEnum):
     """Enum for subtask constraint types."""
